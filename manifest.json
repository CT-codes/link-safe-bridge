{
    "manifest_version": 3,
    "name": "Link-Safe Bridge",
    "version": "1.4.0",
    "description": "Spiegelt deine Link-Safe-Sammlung in die Lesezeichenleiste, speichert Seiten und Notizen nach Link-Safe und prüft die Sammlung auf tote Links.",
    "permissions": ["bookmarks", "storage", "alarms", "scripting", "activeTab"],
    "optional_permissions": ["webNavigation"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Link-Safe Bridge"
    },
    "options_page": "options.html",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
