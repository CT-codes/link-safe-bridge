{
    "manifest_version": 3,
    "name": "Link-Safe Bridge",
    "version": "1.6.0",
    "description": "Spiegelt deine Link-Safe-Sammlung in die Lesezeichenleiste, speichert Seiten und Notizen nach Link-Safe und prüft die Sammlung auf tote Links.",
    "permissions": ["bookmarks", "storage", "scripting", "activeTab", "tabs"],
    "optional_permissions": ["webNavigation"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Link-Safe Bridge",
        "default_icon": {
            "16": "icon-16.png",
            "32": "icon-32.png"
        }
    },
    "options_page": "options.html",
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    }
}
